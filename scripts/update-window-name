#!/bin/sh

target_pane=$1
[ -n "$target_pane" ] || exit 0

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

pane_active=$(tmux display-message -p -t "$target_pane" '#{pane_active}' 2>/dev/null) || exit 0
[ "$pane_active" = 1 ] || exit 0

window_id=$(tmux display-message -p -t "$target_pane" '#{window_id}' 2>/dev/null) || exit 0
automatic_rename=$(tmux show-options -A -v -w -t "$window_id" automatic-rename 2>/dev/null) || exit 0
[ "$automatic_rename" = on ] || exit 0

directory=$(tmux display-message -p -t "$target_pane" '#{pane_current_path}' 2>/dev/null) || exit 0
anchors=$(tmux show-options -gqv @tmux-anchor-window-name-anchors 2>/dev/null)
[ -n "$anchors" ] || anchors=dir:.git
separator=$(tmux show-options -gqv @tmux-anchor-window-name-separator 2>/dev/null)
[ -n "$separator" ] || separator=,

if folder_name=$("$script_dir/folder-name" "$directory" "$anchors" "$separator"); then
    rename_format=$(printf '%s' "$folder_name" | sed 's/#/##/g')
    window_name=$rename_format
else
    rename_format='#{pane_current_command}'
    window_name=$(tmux display-message -p -t "$target_pane" '#{pane_current_command}' 2>/dev/null) || exit 0
    window_name=$(printf '%s' "$window_name" | sed 's/#/##/g')
fi
[ -n "$window_name" ] || exit 0

tmux set-window-option -t "$window_id" automatic-rename-format "$rename_format" \; \
    rename-window -t "$window_id" "$window_name" \; \
    set-window-option -t "$window_id" automatic-rename on 2>/dev/null
